---
import Default from "@astrojs/starlight/components/Head.astro";
import type { Props } from "@astrojs/starlight/props";

// Get the Starlight route from locals
const route = Astro.locals.starlightRoute;
const entryId = route.entry.id;

// Construct the OG image path based on the entry id
let ogRoute = entryId ? entryId.replace(/\.(md|mdx)$/, "") : "index";
const ogImagePath = `/og/${ogRoute}.png`;

// Construct full URL for OG image
const ogImageUrl = new URL(ogImagePath, Astro.site);
---

<Default {...Astro.props} />

<!-- Open Graph image -->
<meta property="og:image" content={ogImageUrl} />

<!-- Twitter image -->
<meta property="twitter:image" content={ogImageUrl} />
